@page
@model ProductManagement.Pages.User.SignUpModel

@{
    ViewData["Title"] = "Sign Up";
}

<style>
    .signup-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        background: #f3f6fb;
    }

    .signup-card {
        width: 100%;
        max-width: 450px;
        padding: 35px;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }

    .signup-card h1 {
        text-align: center;
        color: #1e293b;
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .signup-subtitle {
        text-align: center;
        color: #64748b;
        margin-bottom: 28px;
    }

    .signup-field {
        margin-bottom: 20px;
    }

    .signup-field label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-weight: 600;
    }

    .signup-field input {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        font-size: 15px;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .signup-field input:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }

    .signup-button {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 9px;
        background: #4f46e5;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

    .signup-button:hover {
        background: #4338ca;
    }

    .signup-footer {
        text-align: center;
        margin-top: 22px;
        color: #64748b;
        font-size: 14px;
    }

    .signup-footer a {
        color: #4f46e5;
        text-decoration: none;
        font-weight: 600;
    }

    .signup-footer a:hover {
        text-decoration: underline;
    }

    .text-danger {
        display: block;
        color: #dc2626;
        font-size: 13px;
        margin-top: 5px;
    }
</style>

<div class="signup-page">
    <div class="signup-card">

        <h1>Create Account</h1>
        <p class="signup-subtitle">
            Sign up to get started
        </p>

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="signup-field">
                <label asp-for="User.Name">Full Name</label>
                <input asp-for="User.Name"
                       type="text"
                       placeholder="Enter your full name" />
                <span asp-validation-for="User.Name"
                      class="text-danger"></span>
            </div>

            <div class="signup-field">
                <label asp-for="User.Email">Email Address</label>
                <input asp-for="User.Email"
                       type="email"
                       placeholder="Enter your email" />
                <span asp-validation-for="User.Email"
                      class="text-danger"></span>
            </div>

            <div class="signup-field">
                <label asp-for="User.Age">Age</label>
                <input asp-for="User.Age"
                       type="number"
                       placeholder="Enter your age"
                       min="1"
                       max="120" />
                <span asp-validation-for="User.Age"
                      class="text-danger"></span>
            </div>

            <div class="signup-field">
                <label asp-for="User.Password">Password</label>
                <input asp-for="User.Password"
                       type="password"
                       placeholder="Create a password" />
                <span asp-validation-for="User.Password"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="signup-button">
                Create Account
            </button>

        </form>

        <div class="signup-footer">
            Already have an account?
            <a asp-page="/User/SignIn">Sign in</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
