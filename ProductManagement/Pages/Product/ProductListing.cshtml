@page
@model ProductManagement.Pages.Product.ProductListingModel
@{
}
<style>
    .listing-container {
        padding: 30px;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    .listing-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

    .listing-header h1 {
        color: #333;
        margin: 0;
        font-size: 28px;
    }

    .listing-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        overflow-x: auto;
    }

    .product-table {
        width: 100%;
        min-width: 750px;
        border-collapse: collapse;
    }

    .product-table th {
        background: #667eea;
        color: white;
        padding: 15px;
        text-align: left;
    }

    .product-table td {
        padding: 14px 15px;
        border-bottom: 1px solid #eee;
        color: #444;
    }

    .product-table tbody tr:hover {
        background: #f7f8ff;
    }

    .btn {
        display: inline-block;
        padding: 7px 12px;
        border: none;
        border-radius: 5px;
        color: white;
        font-size: 13px;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-view {
        background: #17a2b8;
    }

    .btn-edit {
        background: #f0ad4e;
    }

    .btn-delete {
        background: #dc3545;
    }

    .btn-add {
        background: #667eea;
        padding: 11px 18px;
        border-radius: 7px;
        text-decoration: none;
        color: white;
        font-weight: 600;
    }

    .btn:hover {
        opacity: 0.85;
        color: white;
    }

    .actions {
        display: flex;
        gap: 7px;
        align-items: center;
    }

    .empty-message {
        text-align: center;
        padding: 25px !important;
        color: #777 !important;
    }
</style>

<div class="listing-container">

    <div class="listing-header">
        <h1>Product Listing</h1>

        <a asp-page="/Product/CreateProduct" class="btn-add">
            + Add Product
        </a>
    </div>

    <div class="listing-card">
        <table class="product-table">
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Product Quantity</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Products.Any())
                {
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            
                            <td>@product.ProductName</td>
                            <td>@product.Price.ToString("C")</td>
                            <td>@product.ProductQuantity</td>
                            <td>
                                <div class="actions">
                                    <a asp-page="/Product/ProductView"
                                       asp-route-id="@product.Id"
                                       class="btn btn-view">
                                        View
                                    </a>

                                    <a asp-page="/Product/ProductEdit"
                                       asp-route-id="@product.Id"
                                       class="btn btn-edit">
                                        Edit
                                    </a>

                                    <a asp-page="/Product/Delete"
                                       asp-route-id="@product.Id"
                                       class="btn btn-delete">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-message">
                            No products found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
