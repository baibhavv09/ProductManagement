@page
@model ProductManagement.Pages.Product.CreateProductModel
@{
}


<style>
    .product-container {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px 15px;
        font-family: 'Segoe UI', Arial, sans-serif;
        background: #f4f6fb;
    }

    .product-card {
        width: 100%;
        max-width: 550px;
        background: white;
        padding: 35px;
        border-radius: 14px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        box-sizing: border-box;
    }

    .product-card h1 {
        text-align: center;
        color: #333;
        margin: 0 0 8px;
    }

    .subtitle {
        text-align: center;
        color: #777;
        margin-bottom: 28px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #444;
        font-weight: 600;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 7px;
        font-size: 15px;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.12);
    }

    textarea.form-control {
        resize: vertical;
    }

    .validation {
        color: #dc3545;
        font-size: 13px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 25px;
    }

    .btn {
        flex: 1;
        padding: 12px;
        border: none;
        border-radius: 7px;
        text-align: center;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-save {
        background: #667eea;
        color: white;
    }

    .btn-save:hover {
        background: #5367d5;
    }

    .btn-cancel {
        background: #e9ecef;
        color: #333;
    }

    .btn-cancel:hover {
        background: #d9dde1;
    }
</style>

<div class="product-container">
    <div class="product-card">

        <h1>Create Product</h1>
        <p class="subtitle">Enter the details of your new product</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="validation"></div>

            <div class="form-group">
                <label asp-for="Product.ProductName">
                    Product Name
                </label>
                <input asp-for="Product.ProductName"
                       class="form-control"
                       placeholder="Enter product name" />
                <span asp-validation-for="Product.ProductName"
                      class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.ProductDiscription">
                    Product Description
                </label>
                <textarea asp-for="Product.ProductDiscription"
                          class="form-control"
                          rows="4"
                          placeholder="Enter product description"></textarea>
                <span asp-validation-for="Product.ProductDiscription"
                      class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.Price">Price</label>
                <input asp-for="Product.Price"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control"
                       placeholder="Enter price" />
                <span asp-validation-for="Product.Price"
                      class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.ProductQuantity">
                    Product Quantity
                </label>
                <input asp-for="Product.ProductQuantity"
                       type="number"
                       min="0"
                       class="form-control"
                       placeholder="Enter quantity" />
                <span asp-validation-for="Product.ProductQuantity"
                      class="validation"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-save">
                    Save Product
                </button>

                <a asp-page="/Product/ProductListing"
                   class="btn btn-cancel">
                    Cancel
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
